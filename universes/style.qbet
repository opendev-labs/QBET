
/* Quantum Style Layer */
h1 {
    font-size: 5rem;
    color: var(--white);
    text-align: center;
    margin-top: 20vh;
    animation: glow 2s infinite alternate;
}

.manifest-btn {
    background: transparent;
    border: 1px solid var(--green);
    color: var(--green);
    padding: 1rem 3rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: block;
    margin: 2rem auto;
}

.manifest-btn:hover {
    background: var(--green);
    color: #000;
    box-shadow: 0 0 20px var(--green);
}

@keyframes glow {
    from { text-shadow: 0 0 10px var(--dim-green); }
    to { text-shadow: 0 0 30px var(--green), 0 0 10px var(--white); }
}
